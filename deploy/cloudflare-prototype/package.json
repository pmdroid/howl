{
  "name": "howl-control-plane-d1-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "lint": "oxlint --deny-warnings '*.ts' 'web/*.ts' build.mjs test.mjs",
    "format": "oxfmt '*.ts' 'web/*.ts' build.mjs test.mjs",
    "format:check": "oxfmt --check '*.ts' 'web/*.ts' build.mjs test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.2"
  }
}
